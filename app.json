{
  "expo": {
    "name": "School Portal",
    "slug": "portal-app",
    "scheme": "schoolportal",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/brand/logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.schoolportal.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.schoolportal.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#2057D6",
        "foregroundImage": "./assets/brand/logo.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/logo.png",
          "backgroundColor": "#2057D6",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "175a25ea-4dfa-4a80-b9e4-8749432a5914"
      }
    },
    "owner": "shbz0298s-team",
    "updates": {
      "url": "https://u.expo.dev/175a25ea-4dfa-4a80-b9e4-8749432a5914"
    }
  }
}
